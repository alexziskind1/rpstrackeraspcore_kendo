@page
@model RPS.Web.Pages.Backlog.CreateModel


<div class="page">
    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="frame-details d-flex flex-column align-items-start gap-2">
                    <div class="page-title">
                        Add New Item
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="create-item-form">
            <form method="post">

                <div class="form-group row mb-3">
                    <label asp-for="@Model.Title" class="col-sm-2 col-form-label"></label>
                    <div class="col-sm-10">
                        <kendo-textbox for="@Model.Title">
                        </kendo-textbox>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label asp-for="@Model.Description" class="col-sm-2 col-form-label"></label>
                    <div class="col-sm-10">
                        <kendo-textarea for="@Model.Description">
                        </kendo-textarea>
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <label asp-for="@Model.TypeStr" class="col-sm-2 col-form-label"></label>
                    <div class="col-sm-10">

                        @*html helper*@
                        @*@(Html.Kendo().DropDownList()
                               .Name("TypeStr")
                              .BindTo(Model.ItemTypes)
                        )*@

                        @*tag helper*@
                        <kendo-dropdownlist name="TypeStr" value="@Model.TypeStr" bind-to="Model.ItemTypes"></kendo-dropdownlist>

                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="offset-sm-2 col-sm-10">
                        <input type="submit" value="Add" class="btn btn-primary" />
                    </div>
                </div>
            </form>

            <div>
                <a href="/Backlog">Back to List</a>
            </div>
        </div>
    </div>
</div>
