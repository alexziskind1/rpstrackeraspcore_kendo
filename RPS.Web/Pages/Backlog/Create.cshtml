@page
@model RPS.Web.Pages.Backlog.CreateModel


<div class="page">
    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="frame-details d-flex flex-column align-items-start gap-2" style="width: 700px;">
                    <div class="page-title">
                        Add New Item
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form method="post">

    <div class="form-group row">
        <label asp-for="@Model.Title" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <kendo-textbox for="@Model.Title" style="width: 100%;">
            </kendo-textbox>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="@Model.Description" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <kendo-textarea for="@Model.Description" style="width: 100%; height:60px;">
            </kendo-textarea>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="@Model.TypeStr" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">

            @*html helper*@
            @*@(Html.Kendo().DropDownList()
                   .Name("TypeStr")
                  .BindTo(Model.ItemTypes)
            )*@

            @*tag helper*@
            <kendo-dropdownlist name="TypeStr" value="@Model.TypeStr" bind-to="Model.ItemTypes" style="width: 100%;"></kendo-dropdownlist>

        </div>
    </div>


    <div class="form-group row">
        <div class="offset-sm-2 col-sm-10">
            <input type="submit" value="Add" class="btn btn-primary" />
        </div>
    </div>
</form>


<div>
    <a href="/Backlog">Back to List</a>
</div>
