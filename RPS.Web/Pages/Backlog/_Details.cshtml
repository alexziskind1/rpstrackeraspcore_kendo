@model RPS.Web.Pages.Backlog.PtItemDetailsVm

<form method="post">
    <input type="hidden" asp-for="@Model.Id" />


    <div class="form-group row mb-3">
        <label asp-for="@Model.Title" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-6">
            <kendo-textbox for="@Model.Title">
			</kendo-textbox>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label asp-for="@Model.Description" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-6">
            <kendo-textarea for="@Model.Description">
            </kendo-textarea>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label asp-for="@Model.Estimate" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-6">
            <kendo-slider for="@Model.Estimate" min="0" max="20" large-step="1"></kendo-slider>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label asp-for="@Model.SelectedItemType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-6">
            <kendo-dropdownlist 
                name="SelectedItemType" 
                value="@Model.SelectedItemType" 
                bind-to="Model.ItemTypes" 
                template-handler="itemTypeTemplate">
            </kendo-dropdownlist>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label asp-for="@Model.SelectedStatus" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-6">
            <kendo-dropdownlist 
                name="SelectedStatus" 
                value="@Model.SelectedStatus" 
                bind-to="Model.Statuses">
            </kendo-dropdownlist>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label asp-for="@Model.SelectedPriority" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-6">
            <kendo-dropdownlist 
                name="SelectedPriority" 
                value="@Model.SelectedPriority" 
                bind-to="Model.Priorities" 
                template-handler="priorityTemplate">
            </kendo-dropdownlist>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label asp-for="@Model.SelectedAssigneeId" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-6">
            <kendo-dropdownlist name="SelectedAssigneeId" value="@Model.SelectedAssigneeId" bind-to="Model.Users"></kendo-dropdownlist>
        </div>
    </div>


    <div class="form-group row mb-3">
        <div class="offset-sm-2 col-sm-10">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
