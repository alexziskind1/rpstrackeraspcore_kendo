@model RPS.Web.Pages.Backlog.PtItemCommentsVm


<form method="post">

    <input type="hidden" asp-for="@Model.ItemId" />

    <div class="new-comment-form">
        <div class="comment-input-container">
            <user-avatar user="Model.CurrentUser" class="comment-avatar"></user-avatar>

            <kendo-textarea for="@Model.NewCommentText" class="comment-textarea" placeholder="Enter new comment..." style="height:60px;">
            </kendo-textarea>
        </div>
        <div class="comment-button-container">
            <button type="submit" class="btn btn-primary">Add Comment</button>
        </div>
    </div>

    <hr />

    <ul class="list-unstyled">
        @foreach (var comment in Model.Comments)
        {
            <li class="chitchat-item">
                <div class="comment-item-container">
                    <user-avatar user="comment.User" class="comment-avatar"></user-avatar>
                    <div class="media-body">
                        <h6 class="mt-0 mb-1"><span>@comment.User.FullName</span><span class="comment-date">@comment.DateCreated.ToString("MMM d, yyyy")</span></h6>
                        <span type="text" class="chitchat-text">@comment.Title</span>
                    </div>
                </div>
            </li>
        }
    </ul>
</form>
