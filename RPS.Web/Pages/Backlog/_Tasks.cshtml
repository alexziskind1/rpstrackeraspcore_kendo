@model RPS.Web.Pages.Backlog.PtItemTasksVm

<form method="post">
    <input type="hidden" asp-for="@Model.ItemId" />

    <div class="tasks-panel">
        <div class="tasks-inner">

            <div class="tasks-add-row">

                <kendo-textbox for="@Model.NewTaskTitle" class="form-control pt-text-task-add" placeholder="Enter new task...">
                </kendo-textbox>

                <button type="submit" class="btn btn-primary">Add</button>
            </div>

            <div class="tasks-separator-outer">
                <div class="tasks-separator-inner"></div>
            </div>

            @foreach (var task in Model.Tasks)
            {
                <div class="row mb-3">
                    <div class="col">
                        <div class="input-group">
                            <div class="input-group-text">
                                <input type="checkbox" asp-for="@task.Completed" id="pt-task-checkbox-@task.Id" />
                            </div>
                            <input type="text" asp-for="@task.Title" class="form-control" id="pt-task-input-@task.Id" />
                        </div>
                    </div>

                    <div class="col-1">
                        <div class="task-actions">
                            <div class="task-actions-pad">
                                <div class="task-icon-box">
                                    <div class="task-icon-stack">

                                        <button class="pt-btn-task-update"
                                                type="submit"
                                                data-task-id="@task.Id">
                                            <svg viewBox="0 0 512 512" class="task-icon task-icon-edit">
                                                <path d="M471.6 21.7c-21.9-21.9-57.3-21.9-79.2 0L362.3 51.7l97.9 97.9 30.1-30.1c21.9-21.9 21.9-57.3 0-79.2L471.6 21.7zm-299.2 220c-6.1 6.1-10.8 13.6-13.5 21.9l-29.6 88.8c-2.9 8.6-.6 18.1 5.8 24.6s15.9 8.7 24.6 5.8l88.8-29.6c8.4-2.8 15.8-7.5 21.9-13.5L437.7 172.3 339.7 74.3 172.4 241.7zM96 64C43 64 0 107 0 160V416c0 53 43 96 96 96H352c53 0 96-43 96-96V320c0-17.7-14.3-32-32-32s-32 14.3-32 32v96c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32V160c0-17.7 14.3-32 32-32h96c17.7 0 32-14.3 32-32s-14.3-32-32-32H96z" />
                                            </svg>
                                        </button>

                                        <button class="pt-btn-task-delete"
                                                type="submit"
                                                formaction="/Detail/@Model.ItemId/Tasks?handler=Delete&taskId=@task.Id"
                                                data-task-id="@task.Id">
                                            <svg viewBox="0 0 512 512" class="task-icon task-icon-delete">
                                                <path d="M416 96h-96V64c0-17.6-14.4-32-32-32h-96c-17.6 0-32 14.4-32 32v32H64v64h32v288c0 17.6 14.4 32 32 32h224c17.6 0 32-14.4 32-32V160h32zM192 64h95.9l.1.1V96h-96c.1-.1.1-32.1 0-32m160 384H128.1l-.1-.1V160h32v256h32V160h32v256h32V160h32v256h32V160h32z" />
                                            </svg>
                                        </button>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</form>
