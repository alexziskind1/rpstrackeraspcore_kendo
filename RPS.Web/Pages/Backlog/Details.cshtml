@section styles {
    <link href="~/css/detail.css" rel="stylesheet" />
    <link href="~/css/chitchat.css" rel="stylesheet" />
}

@section scripts {
    <partial name="_TasksScripts" />
    @{
        var cspNonce = ViewContext.HttpContext.Items["CspNonce"]?.ToString();
    }
    <script nonce="@cspNonce">
        function itemTypeTemplate(data) {
            return '<img src="/images/icon_' + encodeURIComponent(data) + '.png" class="backlog-icon" />' +
                '<span>' + kendo.htmlEncode(data) + '</span>';
        }

        function priorityTemplate(data) {
            return '<span class="badge priority-' + kendo.htmlEncode(String(data).toLowerCase()) + '">' +
                kendo.htmlEncode(data) + '</span>';
        }

        function onTabSelect(e) {
            var itemId = document.getElementById('itemTitle').getAttribute('data-item-id');
            var urlsByTab = {
                Form: '/Detail/' + itemId,
                Tasks: '/Detail/' + itemId + '/Tasks',
                Chitchat: '/Detail/' + itemId + '/Chitchat'
            };
            var tab = e.item.jquery ? e.item[0] : e.item;
            var url = urlsByTab[tab.textContent.trim()];

            if (url) {
                history.pushState(null, 'RPS Project Tracker', url);
            }
        }
    </script>
}